APP_NAME="Hotel Bookings Manager"
APP_ENV=local
APP_KEY=base64:ECdMBKhh/ptRJcMrzK2lssRixCC7styNvez42nGEWfA=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
DB_DATABASE=/home/user/Hotel-Bookings/database/database.sqlite
DB_FOREIGN_KEYS=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=database
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
LOG_DEPRECATIONS_CHANNEL=null

VITE_MENDABLE_API_KEY=votre_cle_ici
VITE_APP_NAME="${APP_NAME}"

# --- Configuration Vite ---
VITE_APP_TITLE="${APP_NAME}"
VITE_APP_HOST="${APP_URL}"

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@hotel-bookings.test"
